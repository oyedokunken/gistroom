# Copy to .env. Never commit .env. Only NEXT_PUBLIC_* values reach the browser.

# ---- App URLs ----
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
REALTIME_URL=http://localhost:4000
NEXT_PUBLIC_SITE_NAME=Gistroom

# ---- Database (Supabase). Dev uses the gistroom_dev schema, tests use gistroom_test ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&schema=gistroom_dev
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=gistroom_dev
DATABASE_SCHEMA=gistroom_dev
PRODUCTION_DB_HOST=
# Direct connection used only by `npm run db:migrate:prod`. Leave it out to reuse DIRECT_URL with the schema switched to public.
PRODUCTION_DIRECT_URL=
# Most connections one process may open. Leave it out for the default of 10. On Vercel use a small number such as 3.
DATABASE_POOL_MAX=

# ---- Secrets (generate with: node scripts/gen-secrets.mjs) ----
SESSION_SECRET=
REALTIME_PASS_SECRET=
INTERNAL_SERVICE_TOKEN=
CRON_SECRET=

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Google sign in is built and switched off. Set both to true to turn it on, no code change needed.
GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
GOOGLE_MODE=mock

# ---- Email ----
MAIL_TRANSPORT=console
MAIL_ENABLE_REAL=false
MAIL_ALLOWED_DOMAINS=example.com
MAIL_FROM_NAME=Gistroom
MAIL_FROM_ADDRESS=
SMTP_USER=
SMTP_APP_PASSWORD=

# Where contact form messages go. Outside production use an allowed domain such as support@example.com.
SUPPORT_INBOX=support@example.com

# ---- Supabase Storage ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_MEDIA_BUCKET=media
SUPABASE_PUBLIC_BUCKET=avatars

# ---- LiveKit (web only) ----
LIVEKIT_URL=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Web Push (generate with: node scripts/gen-vapid.mjs) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@gistroom.ng

# ---- Footer social links (leave empty to hide) ----
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# ---- Realtime service only ----
PORT=4000
WEB_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
