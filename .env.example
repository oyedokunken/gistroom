# Copy to .env. Never commit .env. Only NEXT_PUBLIC_* values reach the browser.

# ---- App URLs ----
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
REALTIME_URL=http://localhost:4000
NEXT_PUBLIC_SITE_NAME=Gistroom

# ---- Database (Supabase). Dev uses the gistroom_dev schema, tests use gistroom_test ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&schema=gistroom_dev
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=gistroom_dev
DATABASE_SCHEMA=gistroom_dev
PRODUCTION_DB_HOST=

# ---- Secrets (generate with: node scripts/gen-secrets.mjs) ----
SESSION_SECRET=
REALTIME_PASS_SECRET=
INTERNAL_SERVICE_TOKEN=
CRON_SECRET=

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_MODE=mock

# ---- Email ----
MAIL_TRANSPORT=console
MAIL_ENABLE_REAL=false
MAIL_ALLOWED_DOMAINS=example.com
MAIL_FROM_NAME=Gistroom
MAIL_FROM_ADDRESS=
SMTP_USER=
SMTP_APP_PASSWORD=

# ---- Supabase Storage ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_MEDIA_BUCKET=media
SUPABASE_PUBLIC_BUCKET=avatars

# ---- LiveKit (web only) ----
LIVEKIT_URL=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Web Push (generate with: node scripts/gen-vapid.mjs) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@gistroom.ng

# ---- Realtime service only ----
PORT=4000
WEB_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
