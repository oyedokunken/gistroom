{
  "name": "gistroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gistroom: live talk about Nigeria, in Nigeria.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,rt -c green,yellow \"npm run dev -w apps/web\" \"npm run dev -w apps/realtime\"",
    "build": "npm run build -w packages/shared && npm run build -w apps/web && npm run build -w apps/realtime",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run generate -w @gistroom/db && npm run typecheck --workspaces --if-present",
    "lint:copy": "node scripts/check-copy.mjs",
    "lint:ui": "node scripts/check-ui-rules.mjs",
    "lint:font": "node scripts/check-font-coverage.mjs",
    "audit": "node scripts/audit.mjs",
    "lint:graphics": "node scripts/graphics/verify.mjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:socket": "vitest run --project socket --passWithNoTests",
    "test:browser": "npm run e2e:build && playwright test --grep-invert \"@a11y|@responsive\"",
    "test:a11y": "npm run e2e:build && playwright test --grep @a11y",
    "test:responsive": "npm run e2e:build && playwright test --grep @responsive",
    "verify": "npm run lint:copy && npm run lint:ui && npm run lint:font && npm run lint && npm run typecheck && npm run lint:graphics && npm run test:unit && npm run test:integration && npm run test:socket && npm run build && npm run test:browser && npm run test:a11y && npm run test:responsive",
    "verify:quick": "npm run lint:copy && npm run lint:ui && npm run lint && npm run typecheck && npm run test:unit",
    "brand": "node scripts/brand.mjs",
    "mail:preview": "tsx --tsconfig apps/web/tsconfig.json scripts/mail-preview.ts",
    "db:diff": "node scripts/db-diff.mjs",
    "db:migrate": "node scripts/migrate-schema.mjs",
    "db:seed": "node scripts/assert-safe-db.mjs tsx ../../scripts/seed.ts",
    "db:reset": "node scripts/assert-safe-db.mjs prisma migrate reset --force",
    "db:studio": "npm run studio -w packages/db",
    "prepare": "husky || exit 0",
    "storage:setup": "node scripts/setup-storage.mjs",
    "e2e:build": "npm run build:e2e -w apps/web",
    "db:seed:reference": "tsx scripts/seed.ts --reference",
    "db:migrate:deploy": "npm run migrate:deploy -w @gistroom/db"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js,json,md,css}": [
      "node scripts/check-copy.mjs --files",
      "prettier --write"
    ],
    "*.{ts,tsx,mjs}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@fontsource/noto-sans": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fontkit": "^2.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
