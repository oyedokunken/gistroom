generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, pg_trgm]
}

// ---------- Enums ----------
enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  USER
  ADMIN
}

enum RoomInvitesFrom {
  FRIENDS
  EVERYONE
}

enum AuthProvider {
  GOOGLE
}

enum OtpPurpose {
  SIGN_IN
  SIGN_UP
  RESET_PASSWORD
  DELETE_ACCOUNT
  CHANGE_EMAIL
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ConversationType {
  DM
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  VOICE
  FILE
  ROOM_INVITE
  SYSTEM
}

enum FileStatus {
  PENDING
  ATTACHED
}

enum CallKind {
  DIRECT
}

enum MediaKind {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
  CANCELLED
  BUSY
  FAILED
}

enum Language {
  ENGLISH
  PIDGIN
  YORUBA
  IGBO
  HAUSA
  OTHER
}

/// Who may write in the room chat.
enum RoomChatMode {
  EVERYONE
  MODERATORS
  OFF
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum RoomStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum RoomRole {
  HOST
  MODERATOR
  MEMBER
}

enum RoomMemberState {
  INVITED
  JOINED
  LEFT
  REMOVED
  BANNED
}

enum RoomModAction {
  MUTE
  MUTE_VIDEO
  SETTINGS
  MUTE_ALL
  REMOVE
  BAN
  LOCK
  UNLOCK
  PROMOTE
  DEMOTE
  INVITE
  LINK_CREATED
  LINK_REVOKED
  MESSAGE_DELETED
  END
}

enum LogKind {
  DIRECT
  ROOM
}

enum LogDirection {
  INCOMING
  OUTGOING
  NONE
}

enum LogOutcome {
  ANSWERED
  MISSED
  DECLINED
  CANCELLED
  BUSY
}

enum LogMedia {
  AUDIO
  VIDEO
  MIXED
}

enum ReportTarget {
  USER
  MESSAGE
  ROOM
  ROOM_MESSAGE
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

// ---------- Identity ----------
model User {
  id                String          @id @default(cuid(2))
  email             String          @unique @db.Citext
  emailVerifiedAt   DateTime?
  passwordHash      String?
  passwordUpdatedAt DateTime?
  name              String
  username          String          @unique
  avatarPath        String?
  /// The illustrated avatar picked at sign up, kept until the person uploads their own. A key from packages/shared/src/avatars.ts.
  avatarKey         String?
  /// Internal accounts (QA, staff) are hidden from search, suggestions and public counts for everyone else.
  isInternal        Boolean         @default(false)
  bio               String?
  timezone          String          @default("Africa/Lagos")
  status            UserStatus      @default(ACTIVE)
  role              UserRole        @default(USER)
  discoverable      Boolean         @default(true)
  showPresence      Boolean         @default(true)
  sendReadReceipts  Boolean         @default(true)
  roomInvitesFrom   RoomInvitesFrom @default(FRIENDS)
  dataSaver         Boolean         @default(true)
  onboardedAt       DateTime?
  lastSeenAt        DateTime?
  ageConfirmedAt    DateTime?
  termsAcceptedAt   DateTime?
  deletedAt         DateTime?
  /// The cookie choice the person made, so a new device does not ask again. Shape: { v, functional, analytics }.
  cookieConsent     Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  authAccounts           AuthAccount[]
  sessions               Session[]
  sentRequests           FriendRequest[]         @relation("RequestSender")
  receivedRequests       FriendRequest[]         @relation("RequestReceiver")
  blocksMade             Block[]                 @relation("Blocker")
  blocksReceived         Block[]                 @relation("Blocked")
  memberships            ConversationMember[]
  messages               Message[]
  stars                  MessageStar[]
  reactions              MessageReaction[]
  hiddenMessages         MessageHidden[]
  files                  FileAsset[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  pushSubscriptions      PushSubscription[]
  callsMade              Call[]                  @relation("Caller")
  callsReceived          Call[]                  @relation("Callee")
  hostedRooms            Room[]
  roomMemberships        RoomMember[]
  callLogs               CallLogEntry[]
  interests              UserInterest[]
  notes                  Note[]

  @@index([status, discoverable])
}

/// Topics a person picked at onboarding. The slug comes from the shared topic list, so there is no Topic row to seed.
model UserInterest {
  userId    String
  topicSlug String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topicSlug])
  @@index([topicSlug])
}

model AuthAccount {
  id                String       @id @default(cuid(2))
  userId            String
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id              String    @id @default(cuid(2))
  tokenHash       String    @unique
  userId          String
  userAgent       String?
  deviceLabel     String?
  lastSeenAt      DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  /// The long lived device cookie this session was made on. Push subscriptions belong to the same device.
  deviceId        String?
  /// When the person last proved who they are (password, code or Google). Step up checks read this.
  authenticatedAt DateTime  @default(now())
  /// Why the session ended: EXPIRED, REVOKED_BY_USER, REVOKED_ALL, ACCOUNT_DELETED, INVALID_COOKIE, ERROR or SWEPT.
  endReason       String?
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([deviceId])
  @@index([endedAt])
}

model OtpChallenge {
  id          String     @id @default(cuid(2))
  emailHash   String
  codeHash    String
  purpose     OtpPurpose @default(SIGN_IN)
  attempts    Int        @default(0)
  lastSentAt  DateTime   @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  lockedUntil DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([emailHash, purpose, createdAt])
  @@index([expiresAt])
}

// ---------- Social ----------
model FriendRequest {
  id          String              @id @default(cuid(2))
  requesterId String
  addresseeId String
  status      FriendRequestStatus @default(PENDING)
  respondedAt DateTime?
  retryAfter  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  requester   User                @relation("RequestSender", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User                @relation("RequestReceiver", fields: [addresseeId], references: [id], onDelete: Cascade)

  // The partial unique index (one PENDING per ordered pair) is added in the baseline migration.
  @@index([addresseeId, status, createdAt])
  @@index([requesterId, status, createdAt])
}

model Friendship {
  id                String    @id @default(cuid(2))
  userLowId         String
  userHighId        String
  /**
   * Next friendship anniversary. Set to one year after the friendship starts and moved on a year each time it is celebrated.
   */
  nextAnniversaryAt DateTime?
  celebratedYears   Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userLowId, userHighId])
  @@index([userHighId])
  @@index([nextAnniversaryAt])
}

model Block {
  id        String   @id @default(cuid(2))
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ---------- Chat ----------
model Conversation {
  id            String               @id @default(cuid(2))
  type          ConversationType     @default(DM)
  dmKey         String               @unique
  lastMessageAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  members       ConversationMember[]
  messages      Message[]
  notes         Note[]
}

model ConversationMember {
  id                     String       @id @default(cuid(2))
  conversationId         String
  userId                 String
  archivedAt             DateTime?
  clearedAt              DateTime?
  lastReadMessageId      String?
  lastDeliveredMessageId String?
  mutedUntil             DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  conversation           Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, archivedAt])
}

model Message {
  id                   String              @id @default(cuid(2))
  conversationId       String
  senderId             String
  clientId             String
  type                 MessageType         @default(TEXT)
  body                 String?
  replyToId            String?
  meta                 Json?
  deletedForEveryoneAt DateTime?
  editedAt             DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  conversation         Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender               User                @relation(fields: [senderId], references: [id])
  replyTo              Message?            @relation("Reply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies              Message[]           @relation("Reply")
  attachments          MessageAttachment[]
  stars                MessageStar[]
  reactions            MessageReaction[]
  hiddenBy             MessageHidden[]

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt, id])
}

model MessageAttachment {
  id          String   @id @default(cuid(2))
  messageId   String
  storagePath String
  thumbPath   String?
  mime        String
  sizeBytes   Int
  width       Int?
  height      Int?
  durationMs  Int?
  waveform    Int[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MessageStar {
  id        String   @id @default(cuid(2))
  userId    String
  messageId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
}

model MessageReaction {
  id        String   @id @default(cuid(2))
  userId    String
  messageId String
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
}

model MessageHidden {
  id        String   @id @default(cuid(2))
  userId    String
  messageId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
}

model FileAsset {
  id        String     @id @default(cuid(2))
  ownerId   String
  bucket    String
  path      String
  mime      String
  sizeBytes Int
  status    FileStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([bucket, path])
  @@index([status, createdAt])
}

/// A private note one person keeps about a chat or a room. Only the owner can ever read it.
model Note {
  id             String        @id @default(cuid(2))
  userId         String
  conversationId String?
  roomId         String?
  body           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  room           Room?         @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([userId, conversationId, createdAt])
  @@index([userId, roomId, createdAt])
}

// ---------- Notifications ----------
model Notification {
  id        String    @id @default(cuid(2))
  userId    String
  type      String
  payload   Json
  dedupeKey String?
  /// Activity entries (what you did yourself) expire after a week. Other notices leave this empty.
  expiresAt DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id         String   @id @default(cuid(2))
  userId     String   @unique
  switches   Json     @default("{}")
  previews   Boolean  @default(true)
  quietStart String?
  quietEnd   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id              String    @id @default(cuid(2))
  userId          String
  endpoint        String    @unique
  p256dh          String
  auth            String
  userAgent       String?
  /// The device this browser is. Set by the server in a one year cookie. A subscription never depends on a session.
  deviceId        String?
  deviceLabel     String?
  lastSuccessAt   DateTime?
  failureCount    Int       @default(0)
  /// The session on this device ended more than 30 days ago, so alerts stopped until the person signs in again.
  needsReauth     Boolean   @default(false)
  /// Three failures in a row. The person is told the next time they open the app.
  unhealthyAt     DateTime?
  unhealthySeenAt DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([deviceId])
}

model ScheduledJob {
  id          String    @id @default(cuid(2))
  kind        String
  dueAt       DateTime
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([processedAt, dueAt])
}

// ---------- Calls and Rooms ----------
model Call {
  id            String     @id @default(cuid(2))
  kind          CallKind   @default(DIRECT)
  callerId      String
  calleeId      String
  initialMedia  MediaKind
  status        CallStatus @default(RINGING)
  livekitRoom   String     @unique
  ringExpiresAt DateTime
  answeredAt    DateTime?
  endedAt       DateTime?
  endReason     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  caller        User       @relation("Caller", fields: [callerId], references: [id])
  callee        User       @relation("Callee", fields: [calleeId], references: [id])

  @@index([calleeId, status])
  @@index([callerId, status])
  @@index([status, ringExpiresAt])
}

model Topic {
  id          String   @id @default(cuid(2))
  slug        String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rooms       Room[]
}

model Room {
  id               String           @id @default(cuid(2))
  slug             String           @unique
  hostId           String
  title            String
  topicId          String?
  language         Language         @default(ENGLISH)
  description      String?
  visibility       RoomVisibility   @default(PUBLIC)
  status           RoomStatus       @default(LIVE)
  scheduledFor     DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  locked           Boolean          @default(false)
  maxParticipants  Int              @default(32)
  /// What the room is about: audio talk or video talk. A label only, everyone can switch their camera any time.
  media            MediaKind        @default(AUDIO)
  /// Room settings, changed live by the host and moderators.
  cameraAllowed    Boolean          @default(true)
  joinMuted        Boolean          @default(false)
  chatMode         RoomChatMode     @default(EVERYONE)
  reactionsOn      Boolean          @default(true)
  slowModeSec      Int              @default(0)
  membersCanShare  Boolean          @default(true)
  /// After "mute everyone": only moderators may unmute people.
  unmuteLocked     Boolean          @default(false)
  /// Numbers kept for the summary after the room ends and its chat is gone.
  peakParticipants Int              @default(0)
  messageCount     Int              @default(0)
  reactionCount    Int              @default(0)
  livekitRoom      String           @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  host             User             @relation(fields: [hostId], references: [id])
  topic            Topic?           @relation(fields: [topicId], references: [id])
  members          RoomMember[]
  inviteLinks      RoomInviteLink[]
  modLogs          RoomModLog[]
  messages         RoomMessage[]
  notes            Note[]
  reactions        RoomReaction[]

  @@index([visibility, status, startedAt])
  @@index([topicId, status])
}

model RoomMember {
  id          String          @id @default(cuid(2))
  roomId      String
  userId      String
  role        RoomRole        @default(MEMBER)
  state       RoomMemberState @default(INVITED)
  invitedById String?
  joinedAt    DateTime?
  leftAt      DateTime?
  graceUntil  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  room        Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId, state])
}

model RoomInviteLink {
  id          String    @id @default(cuid(2))
  roomId      String
  tokenHash   String    @unique
  /// The link token, kept so active links can be shown in full to people who may share them. Never sent to anyone else.
  token       String?
  createdById String
  expiresAt   DateTime
  maxUses     Int?
  usedCount   Int       @default(0)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model RoomModLog {
  id        String        @id @default(cuid(2))
  roomId    String
  actorId   String
  action    RoomModAction
  targetId  String?
  meta      Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  room      Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

model RoomMessage {
  id        String         @id @default(cuid(2))
  roomId    String
  senderId  String
  clientId  String
  body      String
  expiresAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  room      Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reactions RoomReaction[]

  @@unique([senderId, clientId])
  @@index([roomId, createdAt])
  @@index([expiresAt])
}

/// A reaction on a message in room chat.
model RoomReaction {
  id        String      @id @default(cuid(2))
  roomId    String
  messageId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  room      Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  message   RoomMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([roomId])
}

model CallLogEntry {
  id            String       @id @default(cuid(2))
  userId        String
  kind          LogKind
  direction     LogDirection
  outcome       LogOutcome
  mediaType     LogMedia
  peerUserId    String?
  roomId        String?
  titleSnapshot String
  searchText    String
  startedAt     DateTime
  durationSec   Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt(sort: Desc), id])
}

// ---------- Safety and ops ----------
model Report {
  id           String       @id @default(cuid(2))
  reporterId   String
  targetType   ReportTarget
  targetId     String
  reason       String
  details      String?
  evidence     Json?
  status       ReportStatus @default(OPEN)
  resolvedById String?
  resolution   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model AuditLog {
  id        String   @id @default(cuid(2))
  actorId   String?
  action    String
  targetId  String?
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model RateLimit {
  id          String   @id @default(cuid(2))
  key         String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([windowStart])
}

model EmailOutbox {
  id        String    @id @default(cuid(2))
  to        String
  template  String
  props     Json
  attempts  Int       @default(0)
  sentAt    DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([sentAt, attempts])
}
